    {
      "@id": "ontomedia:CharacterRegistry",
      "@type": "ontomedia:Registry",
      "ontomedia:name": "Character Registry",
      "ontomedia:description": "Central registry for all characters",
      "ontomedia:hasMainCharacters": {
        "@id": "ontomedia:MainCharacters",
        "@type": "ontomedia:CharacterSet",
        "ontomedia:characters": [
          {
            "@id": "ontomedia:Ellie",
            "@type": "ontomedia:Character",
            "ontomedia:name": "Dr. Eleanor 'Ellie' Hart",
            "ontomedia:role": "Protagonist",
            "ontomedia:insecurities": [
              "Fear of emotional vulnerability",
              "Imposter syndrome in new cultural setting",
              "Worries about living up to mother's legacy",
              "Self-doubt about balancing professional and personal life"
            ],
            "ontomedia:flaws": [
              "Tendency to overwork as emotional avoidance",
              "Stubborn independence that pushes people away",
              "Perfectionism that causes unnecessary stress",
              "Difficulty asking for help",
              "Sometimes too direct in professional settings"
            ],
            "ontomedia:quirks": [
              "Organizes medical supplies when nervous",
              "Makes terrible coffee but insists on making it",
              "Sings off-key in the shower",
              "Forgets to eat when focused on work",
              "Carries her mother's pearl necklace but never wears it"
            ],
            "ontomedia:development": [
              "Professional facade cracks",
              "Personal conflict emerges",
              "Future uncertainty begins",
              "Cultural adaptation",
              "Professional growth",
              "Personal healing",
              "Family reconciliation",
              "Community leadership"
            ],
            "ontomedia:relationships": [
              "Tense with Sarah",
              "Respected by colleagues",
              "Connected to mother's memory",
              "Growing bond with Lily",
              "Professional respect from Dr. Jensen",
              "Community acceptance",
              "Mentorship of young doctor",
              "Friendship with local artist",
              "Reconnection with father"
            ],
            "ontomedia:requirements": [
              "Reference:ontomedia:RequirementsRegistry.CoreRequirements.CharacterRequirements.AuthenticDevelopment",
              "Reference:ontomedia:RequirementsRegistry.CoreRequirements.StyleRequirements.ProfessionalAccuracy"
            ]
          },
          {
            "@id": "ontomedia:Tom",
            "@type": "ontomedia:Character",
            "ontomedia:name": "Tom Nielsen",
            "ontomedia:role": "Male Lead",
            "ontomedia:backstory": {
              "ontomedia:marriage": {
                "ontomedia:date": "2010",
                "ontomedia:end_date": "2015",
                "ontomedia:circumstances": "Amicable separation due to Sarah's career ambitions",
                "ontomedia:impact": "Strengthened bond with Lily, developed protective instincts"
              },
              "ontomedia:business_development": {
                "ontomedia:start_date": "2012",
                "ontomedia:growth": "Gradual expansion from small B&B to successful island business",
                "ontomedia:challenges": "Balancing business growth with single parenthood"
              },
              "ontomedia:parenting_journey": {
                "ontomedia:key_moments": [
                  "Primary caregiver since Lily was 3",
                  "Developed strong father-daughter bond",
                  "Established stable routine for Lily"
                ]
              }
            },
            "ontomedia:development": [
              "Initial wariness of new relationships",
              "Growing trust in Ellie",
              "Balancing fatherhood and romance",
              "Professional growth",
              "Emotional vulnerability",
              "Family integration"
            ]
          },
          {
            "@id": "ontomedia:Lily",
            "@type": "ontomedia:Character",
            "ontomedia:name": "Lily Nielsen",
            "ontomedia:role": "Supporting Character",
            "ontomedia:age": "12",
            "ontomedia:school_schedule": {
              "ontomedia:spring": {
                "ontomedia:start_date": "March 1",
                "ontomedia:end_date": "June 15",
                "ontomedia:activities": [
                  "Regular school attendance",
                  "Art classes after school",
                  "Weekend family time"
                ]
              },
              "ontomedia:summer": {
                "ontomedia:start_date": "June 16",
                "ontomedia:end_date": "August 15",
                "ontomedia:activities": [
                  "Summer art program",
                  "Family business help",
                  "Island activities"
                ]
              }
            },
            "ontomedia:development": [
              "Initial artistic connection with Ellie",
              "Growing trust in new family dynamic",
              "Balancing school and family life",
              "Artistic growth",
              "Family integration",
              "Community belonging"
            ]
          }
        ]
      },
      "ontomedia:hasSupportingCharacters": {
        "@id": "ontomedia:SupportingCharacters",
        "@type": "ontomedia:CharacterSet",
        "ontomedia:characters": [
          {
            "@id": "ontomedia:Sarah",
            "@type": "ontomedia:Character",
            "ontomedia:name": "Sarah",
            "ontomedia:role": "Antagonist",
            "ontomedia:insecurities": [
              "Fear of being alone",
              "Jealousy of others' success",
              "Need for control stems from past abandonment"
            ],
            "ontomedia:flaws": [
              "Manipulative tendencies",
              "Difficulty accepting rejection",
              "Overcompensates with control",
              "Struggles with empathy"
            ],
            "ontomedia:quirks": [
              "Always carries a planner",
              "Over-apologizes",
              "Compulsively checks phone"
            ],
            "ontomedia:development": "Shows controlling nature and personal growth",
            "ontomedia:requirements": [
              "Reference:ontomedia:RequirementsRegistry.CoreRequirements.CharacterRequirements.AuthenticDevelopment"
            ]
          }
        ]
      }
