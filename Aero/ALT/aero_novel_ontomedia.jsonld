      "ontomedia:hasIslandCulture": {
        "@id": "ontomedia:IslandCulture",
        "@type": "ontomedia:CulturalSet",
        "ontomedia:name": "Island Culture",
        "ontomedia:description": "Local island cultural elements",
        "ontomedia:requirements": {
          "@id": "ontomedia:IslandCultureRequirements",
          "@type": "ontomedia:RequirementSet",
            "ontomedia:guidelines": [
            "Authentic local traditions and customs",
            "Accurate representation of island life",
            "Respectful portrayal of local beliefs",
            "Natural integration of cultural elements"
            ]
        },
        "ontomedia:elements": [
          {
            "@id": "ontomedia:LocalTraditions",
            "@type": "ontomedia:CulturalElement",
            "ontomedia:name": "Local Traditions",
            "ontomedia:description": "Island customs and practices",
            "ontomedia:details": [
              "Hygge - Danish concept of coziness and contentment",
              "Ærøskøbing's historic cobblestone streets and colorful houses",
              "Ærø Bryghus - local brewery known for Ærø Pilsner",
              "Traditional Danish pastries (wienerbrød) from local bakeries",
              "Ærøskøbing's maritime heritage and fishing traditions",
              "Ærøskøbing's famous Christmas market tradition",
              "Local 'Ærøskøbing Æblemost' (apple juice) production",
              "Traditional Danish 'fællesspisning' (community dining)",
              "Ærøskøbing's historic windmill and its cultural significance",
              "Local 'æbleskiver' (Danish pancake balls) tradition",
              "Ærøskøbing's annual maritime festival"
            ]
          },
          {
            "@id": "ontomedia:IslandLife",
            "@type": "ontomedia:CulturalElement",
            "ontomedia:name": "Island Life",
            "ontomedia:description": "Daily life and community dynamics"
          }
        ]
      }
    },
