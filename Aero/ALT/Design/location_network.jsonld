          {
            "@id": "ontomedia:clinic",
            "@type": "ontomedia:Location",
            "ontomedia:name": "Rural Medical Clinic",
            "ontomedia:description": "The main medical facility serving the community",
            "ontomedia:has_progression": {
              "@id": "ontomedia:clinic_progression",
              "@type": "ontomedia:LocationProgression",
              "ontomedia:name": "Clinic Evolution",
              "ontomedia:description": "The development of the clinic throughout the story",
              "ontomedia:has_stage": [
                {
                  "@id": "ontomedia:clinic_initial",
                  "@type": "ontomedia:LocationStage",
                  "ontomedia:name": "Initial State",
                  "ontomedia:description": "Traditional rural clinic setup",
                  "ontomedia:key_elements": [
                    "Basic facilities",
                    "Traditional methods",
                    "Community familiarity"
                  ]
                },
                {
                  "@id": "ontomedia:clinic_transition",
                  "@type": "ontomedia:LocationStage",
                  "ontomedia:name": "Transition",
                  "ontomedia:description": "Integration of modern and traditional approaches",
                  "ontomedia:key_elements": [
                    "Facility updates",
                    "Method integration",
                    "Community adaptation"
                  ]
                },
                {
                  "@id": "ontomedia:clinic_integrated",
                  "@type": "ontomedia:LocationStage",
                  "ontomedia:name": "Integrated State",
                  "ontomedia:description": "Balanced modern-traditional facility",
                  "ontomedia:key_elements": [
                    "Modern facilities",
                    "Cultural integration",
                    "Community center"
                  ]
