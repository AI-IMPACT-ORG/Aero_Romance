      "ontomedia:has_registry": {
        "@id": "ontomedia:character_registry",
        "@type": "ontomedia:CharacterRegistry",
        "ontomedia:has_character": [
          {
            "@id": "ontomedia:dr_sarah_mitchell",
            "@type": "ontomedia:Character",
            "ontomedia:name": "Dr. Sarah Mitchell",
            "ontomedia:description": "A dedicated doctor seeking new purpose",
            "ontomedia:has_arc": {
              "@id": "ontomedia:sarah_professional_arc",
              "@type": "ontomedia:CharacterArc",
              "ontomedia:name": "Professional Transformation",
              "ontomedia:description": "Journey from urban medicine to rural healthcare",
              "ontomedia:has_stage": [
                {
                  "@id": "ontomedia:sarah_initial_conflict",
                  "@type": "ontomedia:CharacterStage",
                  "ontomedia:name": "Initial Conflict",
                  "ontomedia:description": "Struggling with urban medicine burnout",
                  "ontomedia:key_developments": [
                    "Professional dissatisfaction",
                    "Cultural disconnection",
                    "Search for meaning"
                  ]
                },
                {
                  "@id": "ontomedia:sarah_adaptation",
                  "@type": "ontomedia:CharacterStage",
                  "ontomedia:name": "Adaptation",
                  "ontomedia:description": "Learning to practice in rural setting",
                  "ontomedia:key_developments": [
                    "Cultural learning",
                    "Medical adaptation",
                    "Community integration"
                  ]
                },
                {
                  "@id": "ontomedia:sarah_integration",
                  "@type": "ontomedia:CharacterStage",
                  "ontomedia:name": "Integration",
                  "ontomedia:description": "Finding balance in new environment",
                  "ontomedia:key_developments": [
                    "Professional fulfillment",
                    "Cultural competence",
                    "Community belonging"
                  ]
                }
              ]
            }
          },
          {
            "@id": "ontomedia:tom_osullivan",
            "@type": "ontomedia:Character",
            "ontomedia:name": "Tom O'Sullivan",
            "ontomedia:description": "Local doctor with deep community roots",
            "ontomedia:has_arc": {
              "@id": "ontomedia:tom_personal_arc",
              "@type": "ontomedia:CharacterArc",
              "ontomedia:name": "Personal Growth",
              "ontomedia:description": "Journey of opening up to new possibilities",
              "ontomedia:has_stage": [
                {
                  "@id": "ontomedia:tom_initial_resistance",
                  "@type": "ontomedia:CharacterStage",
                  "ontomedia:name": "Initial Resistance",
                  "ontomedia:description": "Resistant to change and new approaches",
                  "ontomedia:key_developments": [
                    "Professional pride",
                    "Cultural protection",
                    "Personal barriers"
                  ]
                },
                {
                  "@id": "ontomedia:tom_growth",
                  "@type": "ontomedia:CharacterStage",
                  "ontomedia:name": "Growth",
                  "ontomedia:description": "Learning to embrace change",
                  "ontomedia:key_developments": [
                    "Professional evolution",
                    "Cultural adaptation",
                    "Personal opening"
                  ]
                },
                {
                  "@id": "ontomedia:tom_transformation",
