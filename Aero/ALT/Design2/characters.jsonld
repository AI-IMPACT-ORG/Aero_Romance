      "ontomedia:has_supporting_cast": [
        {
          "@id": "ontomedia:mads",
          "@type": "ontomedia:Character",
          "ontomedia:name": "Mads O'Sullivan",
          "ontomedia:role": "supporting",
          "ontomedia:age": 29,
          "ontomedia:description": "Local doctor with deep community roots, though sometimes too cautious about change",
          "ontomedia:background": "Born and raised on Ærø, returned to the island after medical school to take over the local practice. Carries the weight of being the island's only doctor. Recently completed his specialization in general medicine and is considering expanding the clinic's services.",
          "ontomedia:flaws": [
            "Overly protective of his patients",
            "Sometimes too traditional in his approach",
            "Hesitant to trust new methods"
          ],
          "ontomedia:has_arc": {
