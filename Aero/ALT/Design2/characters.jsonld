        {
          "@id": "ontomedia:jakob",
          "@type": "ontomedia:Character",
          "ontomedia:name": "Jakob Møller",
          "ontomedia:role": "supporting",
          "ontomedia:age": 65,
          "ontomedia:description": "Island historian and jazz musician who knew Katrine's grandmother well, though sometimes too lost in the past",
          "ontomedia:background": "Former Copenhagen jazz club owner who moved to Ærø thirty years ago. Started the island's jazz festival and maintains the local archives. Was close friends with Katrine's grandmother and helped her with her medical practice. Knows many island secrets and family histories.",
          "ontomedia:flaws": [
            "Can be overly nostalgic",
            "Sometimes too focused on preserving the past",
            "Tends to ramble when telling stories"
          ],
          "ontomedia:redeeming_qualities": [
            "Deep knowledge of island history",
            "Excellent jazz pianist",
            "Genuine care for preserving island heritage",
            "Helps connect people through music and stories"
          ],
