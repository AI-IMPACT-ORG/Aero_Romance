        {
          "@id": "ontomedia:sarah",
          "@type": "ontomedia:Character",
          "ontomedia:name": "Sofie Nielsen",
          "ontomedia:role": "supporting",
          "ontomedia:age": 28,
          "ontomedia:description": "Mads's high school sweetheart, now a widowed island resident with rekindled feelings for him, though sometimes too eager to please",
          "ontomedia:background": "Grew up on Ærø, was Mads's girlfriend throughout high school. They broke up when she married a local fisherman at 22, who was lost at sea three years ago. Has been raising their daughter Lily while running their family home. Recently started considering moving forward with her life, though still deeply connected to her husband's memory. Her reconnection with Mads has stirred old feelings she thought were long buried.",
          "ontomedia:flaws": [
            "Can be overly competitive",
            "Sometimes too focused on appearances",
            "Struggles with letting go of the past",
            "Tends to romanticize her high school relationship with Mads"
          ],
          "ontomedia:redeeming_qualities": [
            "Excellent cook and hostess",
            "Deeply caring mother",
            "Active in community charity work",
            "Genuine love for the island and its traditions"
          ],
          "ontomedia:has_arc": {
            "@id": "ontomedia:sarah_arc",
            "@type": "ontomedia:CharacterArc",
            "ontomedia:name": "Moving Forward",
