  "@graph": [
    {
      "@id": "ontomedia:character_cast",
      "@type": "ontomedia:CharacterCast",
      "ontomedia:has_protagonist": {
        "@id": "ontomedia:katrine",
        "@type": "ontomedia:Character",
        "ontomedia:name": "Dr. Katrine Christiansen",
        "ontomedia:role": "protagonist",
        "ontomedia:age": 28,
        "ontomedia:description": "A dedicated doctor seeking new purpose, though sometimes too stubborn to ask for help",
        "ontomedia:background": "Urban doctor from Copenhagen, perfectionist tendencies from medical school. Spent summers on Ærø with her grandmother until age 12, when her grandmother moved to Copenhagen. The island holds childhood memories of carefree days and her grandmother's stories. Recently completed her medical residency and is at a crossroads in her career.",
        "ontomedia:flaws": [
          "Tends to overthink decisions",
          "Sometimes too independent for her own good",
          "Struggles to admit when she's wrong"
        ],
        "ontomedia:has_arc": {
          "@id": "ontomedia:katrine_arc",
          "@type": "ontomedia:CharacterArc",
          "ontomedia:name": "Professional and Personal Transformation",
          "ontomedia:stages": [
            {
              "@id": "ontomedia:katrine_initial",
              "@type": "ontomedia:CharacterStage",
              "ontomedia:name": "Initial State",
              "ontomedia:description": "Urban doctor facing burnout",
              "ontomedia:sequence": 1
            },
            {
              "@id": "ontomedia:katrine_transition",
              "@type": "ontomedia:CharacterStage",
              "ontomedia:name": "Transition",
              "ontomedia:description": "Adapting to island life",
              "ontomedia:sequence": 2
            },
            {
              "@id": "ontomedia:katrine_transformed",
              "@type": "ontomedia:CharacterStage",
              "ontomedia:name": "Transformed",
              "ontomedia:description": "Integrated into island community",
              "ontomedia:sequence": 3
            }
          ]
        },
        "ontomedia:has_special_object": [
          {
            "@id": "ontomedia:grandmother_necklace",
            "@type": "ontomedia:SpecialObject",
            "ontomedia:name": "Grandmother's Necklace",
            "ontomedia:description": "A delicate silver necklace with a small Ærø charm",
            "ontomedia:significance": "Connection to Katrine's grandmother and her island heritage",
            "ontomedia:origin": "Gift from grandmother before her death",
            "ontomedia:emotional_value": "High",
            "ontomedia:triggers": ["ontomedia:katrine_initial", "ontomedia:katrine_transition"]
          }
        ],
