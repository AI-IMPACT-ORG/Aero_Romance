                      "sensory_details": ["Heated discussion", "Thunder", "Rain on windows", "Tense silence", "Herb scents", "Sketchbook pages", "Coffee brewing"],
                      "emotional_tone": "Conflict, determination, community unity, professional pride",
                      "cultural_elements": {
                        "language": ["Medical terms", "Traditional healing terms", "Community voices"],
                        "traditions": ["Community gathering", "Healing practices", "Island support"],
