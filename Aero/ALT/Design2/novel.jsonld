                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_4_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Test",
                    "ontomedia:description": "Katrine faces her first major test when a group of children falls ill with the mysterious disease. Her determination to solve the mystery grows as she realizes this is her chance to prove the value of combining traditional and modern medicine.",
                    "ontomedia:key_plot_point": "First major medical challenge",
                    "ontomedia:narrative_devices": {
                      "setting": "School building",
                      "weather": "Fog rolling in",
                      "time_of_day": "Morning",
