            },
            {
              "@id": "ontomedia:chapter_3",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 3,
              "ontomedia:name": "The First Steps",
              "ontomedia:description": "Katrine's first small victories and challenges in island medicine",
              "ontomedia:emotional_arc": "uncertainty_to_determination",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
