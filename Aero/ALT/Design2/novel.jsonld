                      },
                      "anna": {
                        "stage": "community_building",
                        "growth": "Creating healing space",
                        "emotional_state": "Supportive presence"
                      }
                    },
                    "ontomedia:narrative_devices": {
                      "setting": "Fisherman's cottage",
                      "weather": "Clear morning",
                      "time_of_day": "Morning",
                      "symbolic_elements": ["Medical bag", "Traditional remedies", "Sea view", "Herb basket", "Sketchbook", "Coffee tray"],
