                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_6_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Fun and Games",
                    "ontomedia:description": "Katrine experiences the joy of island life - her first successful traditional healing, a community celebration, and growing connection with Mads. For the first time, she feels truly at home, not just as a doctor, but as a person. The island's rhythms begin to match her own heartbeat, and she starts to see a future here that she hadn't imagined possible. However, Sofia's presence at the celebration, her Mediterranean beauty and deep connection to the island's traditions, creates an undercurrent of tension that Katrine can't ignore. Each time Sofia shares a story about her childhood with Mads, or demonstrates a traditional healing method, Katrine feels like an outsider looking in.",
                    "ontomedia:key_plot_point": "The idealized version of island life with underlying tension",
                    "ontomedia:character_development": {
                      "katrine": {
                        "stage": "growing_confidence",
                        "growth": "First real sense of belonging",
                        "emotional_state": "Joy mixed with insecurity"
                      },
                      "sofia": {
                        "stage": "rival_introduction",
                        "growth": "Establishing connection to island",
                        "emotional_state": "Confident, traditional"
                      }
                    },
                    "ontomedia:narrative_devices": {
                      "setting": "Town square",
                      "weather": "Perfect summer day",
                      "time_of_day": "Afternoon",
