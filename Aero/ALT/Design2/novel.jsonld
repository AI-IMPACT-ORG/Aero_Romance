              "@type": "ontomedia:Chapter",
              "ontomedia:number": 6,
              "ontomedia:name": "The Community Response",
              "ontomedia:description": "The island's reaction to Katrine's methods creates both support and conflict",
              "ontomedia:emotional_arc": "anxiety_to_conflict",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
