                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_5_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Investigation",
                    "ontomedia:description": "The medical board arrives to investigate Katrine's unconventional methods, creating tension in the community.",
                    "ontomedia:key_plot_point": "Professional conflict and community tension",
                    "ontomedia:narrative_devices": {
                      "setting": "Clinic waiting room",
                      "weather": "Grey, overcast",
                      "time_of_day": "Morning",
                      "symbolic_elements": ["Medical board files", "Clinic door", "Community gathering outside"],
