                      }
                    }
                  },
                  {
                    "@id": "ontomedia:scene_6_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Gathering Storm",
                    "ontomedia:description": "As the medical board's investigation intensifies, Katrine and Sofia prepare in the herb garden. 'Vi må være forberedt,' Sofia whispers, gathering traditional remedies. The approaching storm mirrors the growing tension, while the garden's resilience in the face of changing weather becomes a metaphor for their determination. The first raindrops fall just as they receive news of the board's preliminary findings, each drop like a challenge to their traditional methods.",
                    "ontomedia:key_plot_point": "Investigation intensifies",
                    "ontomedia:character_development": {
                      "katrine": {
                        "stage": "professional_challenge",
                        "growth": "Standing firm in beliefs",
                        "emotional_state": "Determined resilience"
                      },
                      "sofia": {
                        "stage": "mentor_support",
                        "growth": "Sharing traditional wisdom",
                        "emotional_state": "Protective guidance"
                      }
                    },
                    "ontomedia:narrative_devices": {
