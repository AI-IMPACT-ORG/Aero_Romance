              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_3_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_3_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First House Call",
                    "ontomedia:description": "Katrine's first house call to a fisherman's cottage becomes a small victory as she successfully treats a minor injury using both modern and traditional methods. Sofia, having observed her morning walk, arrives unexpectedly with her herb basket, offering to assist. Their professional interaction becomes a delicate dance of modern and traditional medicine, as Sofia demonstrates the preparation of a traditional poultice while Katrine applies modern antiseptic. The fisherman's wife, watching from the kitchen, shares stories of how Katrine's grandmother would combine both approaches. Lily, having followed them, sketches the scene, capturing the moment where two healing traditions begin to merge. Anna arrives with coffee and pastries, turning the medical visit into an impromptu community gathering that bridges the gap between old and new.",
                    "ontomedia:key_plot_point": "First medical success and beginning of professional integration",
                    "ontomedia:character_development": {
                      "katrine": {
                        "stage": "initial_adaptation",
                        "growth": "Learning to integrate approaches",
                        "emotional_state": "Professional curiosity"
                      },
                      "sofia": {
