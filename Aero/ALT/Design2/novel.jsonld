              },
              "ontomedia:weather": "ontomedia:aero_weather_spring"
            },
            {
              "@id": "ontomedia:chapter_2",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 2,
              "ontomedia:name": "The Arrival",
              "ontomedia:description": "Katrine's first day at the clinic reveals both the challenges and possibilities of island life",
              "ontomedia:emotional_arc": "wonder_to_uncertainty",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:island_medical_practice",
                "ontomedia:contrast": "ontomedia:aeroskobing"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_2_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_2_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Meeting",
                    "ontomedia:description": "Katrine arrives at the ferry dock, her medical bag slipping from her shoulder. Mads catches it, their hands meeting over her grandmother's stethoscope. 'Dette tilhørte Dr. Marie Nielsen,' he says, recognizing the family heirloom. 'Hun var min første mentor.' The moment becomes a bridge between past and present, as Katrine feels the weight of her grandmother's legacy and the promise of new beginnings. Sofia watches from a distance, her expression a mix of professional respect and personal concern. Lily, sketching the scene, captures the moment's significance in her art, while Anna's warm welcome helps ease Katrine's initial uncertainty.",
                    "ontomedia:key_plot_point": "First connection to island and potential romance",
                    "ontomedia:character_development": {
                      "katrine": {
                        "stage": "initial_state",
                        "growth": "First step toward legacy",
                        "emotional_state": "Hopeful uncertainty"
                      },
                      "mads": {
                        "stage": "initial_state",
                        "growth": "Connection to Marie's legacy",
                        "emotional_state": "Respectful recognition"
                      },
                      "sofia": {
                        "stage": "initial_state",
                        "growth": "Professional observation",
                        "emotional_state": "Cautious assessment"
                      },
                      "lily": {
                        "stage": "initial_state",
                        "growth": "Artistic documentation",
                        "emotional_state": "Creative interest"
                      },
                      "anna": {
                        "stage": "initial_state",
                        "growth": "Community welcome",
                        "emotional_state": "Warm support"
                      }
                    },
                    "ontomedia:narrative_devices": {
                      "setting": "Ferry dock, bustling with island life",
                      "weather": "Morning sea mists clearing",
                      "time_of_day": "Early morning arrival",
                      "symbolic_elements": ["Grandmother's stethoscope", "Medical bag", "Ferry deck", "Morning mist", "Art supplies", "Café sign"],
                      "sensory_details": ["Sea air", "Dock sounds", "Bag strap slipping", "Salt spray on lips", "Fresh morning coffee", "Pencil scratching", "Distant conversations"],
                      "emotional_tone": "Hopeful, uncertain, first connection, underlying tension",
