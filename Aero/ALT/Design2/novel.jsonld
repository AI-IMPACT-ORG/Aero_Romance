              "@id": "ontomedia:chapter_8",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 8,
              "ontomedia:name": "The Breaking Point",
              "ontomedia:description": "Katrine faces her greatest challenge when the medical board's decision threatens everything",
