          "ontomedia:description": "Katrine's journey reaches its climax as she must choose between her past and future",
          "ontomedia:chapters": [
            {
              "@id": "ontomedia:chapter_9",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 9,
              "ontomedia:name": "The Choice",
              "ontomedia:description": "Katrine must make a difficult decision about her future on the island",
              "ontomedia:emotional_arc": "determination_to_clarity",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
