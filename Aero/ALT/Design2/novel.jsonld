                    }
                  },
                  {
                    "@id": "ontomedia:scene_2_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Medical Infrastructure",
                    "ontomedia:description": "Katrine learns about the island's medical system: the main clinic in Ærøskøbing's historic town center where she'll work with Mads, and the network of traditional healers. As she tours the clinic, she feels both excitement and trepidation - this is where she'll need to prove herself, both as a doctor and as a person.",
                    "ontomedia:key_plot_point": "Understanding the medical system",
                    "ontomedia:narrative_devices": {
                      "setting": "Island clinic, treatment room",
                      "weather": "Bright midday sun",
                      "time_of_day": "Late morning",
                      "symbolic_elements": ["Old medical ledger", "Treatment room", "Island herbs"],
                      "sensory_details": ["Antiseptic smell", "Child's breathing", "Herb garden scents", "Medicinal taste of herbs"],
                      "emotional_tone": "Professional focus, growing concern, determination"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_2_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Morning",
                    "ontomedia:description": "Katrine's first morning in Ærøskøbing, exploring the town and feeling the weight of her decision. Lily, the young apprentice healer, joins her on her walk, sharing stories about her grandmother's morning routines. Sofia, the island's traditional healer, observes their interaction from her herb shop window, her expression a mix of professional assessment and guarded interest. Anna, busy setting up her café, waves them over, offering fresh pastries and introducing Katrine to the morning market regulars. The scene becomes a delicate dance of first impressions and professional boundaries, as each character begins to find their place in the island's medical community.",
                    "ontomedia:key_plot_point": "First real connection to the island and medical community",
                    "ontomedia:character_development": {
                      "katrine": {
                        "stage": "initial_adaptation",
                        "growth": "First steps toward community integration",
                        "emotional_state": "Cautious hope"
                      },
                      "lily": {
                        "stage": "initial_state",
                        "growth": "Sharing island knowledge",
                        "emotional_state": "Eager to help"
                      },
                      "sofia": {
                        "stage": "initial_state",
                        "growth": "Professional assessment",
                        "emotional_state": "Guarded interest"
                      },
                      "anna": {
                        "stage": "initial_state",
                        "growth": "Community bridge building",
                        "emotional_state": "Warm welcome"
                      }
                    },
                    "ontomedia:narrative_devices": {
                      "setting": "Town streets, morning market",
                      "weather": "Clear morning with sea breeze",
                      "time_of_day": "Early morning",
                      "symbolic_elements": ["Morning market", "Town square", "Harbor view", "Herb shop window", "Café sign", "Medical bag"],
