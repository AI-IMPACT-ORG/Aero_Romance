                  {
                    "@id": "ontomedia:scene_6_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Dinner",
                    "ontomedia:description": "Dinner at Mads's family home in the rural coast, surrounded by traditional gardens. As she sits with his family, Katrine feels the first real sense of belonging to a family again. The warmth of their acceptance helps heal old wounds she didn't know she carried.",
                    "ontomedia:key_plot_point": "Integration into island family life",
