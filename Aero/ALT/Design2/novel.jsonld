                    }
                  },
                  {
                    "@id": "ontomedia:scene_4_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Breakthrough",
                    "ontomedia:description": "Katrine makes a breakthrough in understanding the illness, connecting it to the island's unique ecosystem. The discovery gives her a clear sense of purpose - she's not just treating patients, but preserving a vital part of the island's medical heritage.",
                    "ontomedia:key_plot_point": "First medical breakthrough",
