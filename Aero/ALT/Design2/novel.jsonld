              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_8_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_8_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Letter",
                    "ontomedia:description": "In her cottage, Katrine receives the medical board's decision. The morning light through her window illuminates both her professional achievements and the challenge ahead. Sofia arrives unexpectedly, having heard the news, and shares her own experience with the board's traditional medicine requirements. Lily's sketches of their successful treatments are spread across the table, each one a testament to their integrated approach. Anna brings coffee and pastries, turning the moment into an impromptu strategy session. Jakob's historical knowledge of similar challenges faced by the island's healers provides crucial context. The personal space becomes a crucible for her internal conflict as she reads the letter requiring her return to Copenhagen, while the community's support creates a powerful counterpoint to the board's clinical decision.",
                    "ontomedia:key_plot_point": "Personal crisis point and community support",
