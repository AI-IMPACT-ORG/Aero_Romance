      "character:has_protagonist": {
        "@id": "character:ellie",
        "@type": "character:Protagonist",
        "character:name": "Dr. Eleanor 'Ellie' Hart",
        "character:profession": "General Practitioner with Emergency Medicine Experience",
        "character:age": "Mid-thirties",
        "character:arc": "Finding home and love",
        "character:qualifications": [
          "Completed GP training during residency",
          "Specialized in Emergency Medicine for 5 years",
          "Maintained GP license while working in emergency medicine"
        ],
        "character:physical_description": [
          "Professional appearance",
          "Natural beauty",
          "Tired eyes showing stress",
          "Mother's pearl necklace",
          "Minimalist style"
        ],
        "character:key_traits": [
          "Dedicated doctor",
          "City background",
          "Family legacy",
          "Professional pride",
          "Adaptable nature",
          "Compassionate care"
        ],
        "character:insecurities": [
          "Fear of not living up to her mother's medical legacy",
          "Worries about being too direct in professional settings",
          "Self-doubt about balancing career and personal life",
          "Anxiety about adapting to island life"
        ],
        "character:flaws": [
          "Tendency to overwork as emotional avoidance",
          "Stubborn independence that pushes people away",
          "Perfectionism that causes unnecessary stress",
          "Difficulty asking for help",
          "Sometimes too direct in professional settings"
        ],
        "character:backstory": [
          "Copenhagen roots",
          "Medical family",
          "Career focus",
          "Family loss",
          "Professional success",
          "Personal growth",
          "Island connection"
