        "ontomedia:has_romance_beats": {
          "@id": "ontomedia:romance_beats",
          "@type": "ontomedia:RomanceBeats",
          "ontomedia:has_beat": [
            {
              "@id": "ontomedia:midpoint_crisis",
              "@type": "ontomedia:Beat",
              "ontomedia:name": "The Storm",
              "ontomedia:chapter": 8,
              "ontomedia:description": "A severe storm hits the island, forcing Ellie to make critical medical decisions while Tom is away. This crisis tests her professional capabilities and personal resolve.",
              "ontomedia:emotional_state": "Professional and personal crisis",
              "ontomedia:external_conflict": "Medical emergency during storm",
              "ontomedia:internal_conflict": "Self-doubt vs professional duty"
            },
            {
              "@id": "ontomedia:false_victory",
              "@type": "ontomedia:Beat",
              "ontomedia:name": "The Celebration",
              "ontomedia:chapter": 9,
              "ontomedia:description": "After successfully handling the storm crisis, Ellie receives praise from the community and a job offer from Copenhagen. This creates a false sense of resolution.",
              "ontomedia:emotional_state": "Momentary triumph",
              "ontomedia:external_conflict": "Career opportunity vs island life",
              "ontomedia:internal_conflict": "Professional ambition vs personal happiness"
            },
            {
              "@id": "ontomedia:dark_night",
              "@type": "ontomedia:Beat",
              "ontomedia:name": "The Abyss",
              "ontomedia:chapter": 12,
              "ontomedia:description": "Ellie's decision to leave creates a profound crisis. She faces the loss of her new family, community, and professional purpose. This is her darkest moment.",
              "ontomedia:emotional_state": "Complete despair",
              "ontomedia:external_conflict": "Leaving vs staying",
              "ontomedia:internal_conflict": "Fear vs love"
            }
          ]
        }
      }
