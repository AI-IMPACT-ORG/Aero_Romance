            "ontomedia:description": "Regular ferry service between Ærø and mainland",
            "ontomedia:has_sublocation": [
              {
                "@id": "ontomedia:svendborg",
                "@type": "ontomedia:Location",
                "ontomedia:name": "Svendborg",
                "ontomedia:description": "Mainland port city, gateway to Ærø",
                "ontomedia:has_connection": [
                  {
                    "@id": "ontomedia:svendborg_lars_connection",
                    "@type": "ontomedia:LocationConnection",
                    "ontomedia:character": "ontomedia:lars",
                    "ontomedia:connection_type": "workplace"
                  }
                ]
              },
              {
                "@id": "ontomedia:ferry",
                "@type": "ontomedia:Location",
                "ontomedia:name": "Ærø Ferry",
