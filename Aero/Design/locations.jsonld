                ],
                "ontomedia:has_connection": [
                  {
                    "@id": "ontomedia:ferry_lars_connection",
                    "@type": "ontomedia:LocationConnection",
                    "ontomedia:character": "ontomedia:lars",
                    "ontomedia:connection_type": "workplace"
                  }
                ]
              }
