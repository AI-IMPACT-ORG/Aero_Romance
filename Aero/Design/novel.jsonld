  "@graph": [
    {
      "@id": "ontomedia:novel",
      "@type": "ontomedia:Novel",
      "ontomedia:title": "Ærø's Healing Heart",
      "ontomedia:version": "1.0",
      "ontomedia:last_updated": "2024-03-21",
      "ontomedia:cover_synopsis": "When Dr. Katrine Christiansen leaves her prestigious position in Copenhagen for the remote island of Ærø, she discovers that healing comes in many forms. As she bridges the gap between modern medicine and traditional island remedies, she finds herself drawn to both the island's ancient wisdom and its handsome local doctor, Mads O'Sullivan. But when the medical board threatens to close her clinic, Katrine must fight to preserve not just her grandmother's legacy, but the very heart of Ærø's healing traditions. A captivating tale of love, medicine, and the power of tradition in a modern world.",
      "ontomedia:core_elements": {
        "@id": "ontomedia:core_elements",
        "@type": "ontomedia:CoreElements",
        "ontomedia:protagonist": "ontomedia:katrine",
        "ontomedia:primary_location": "ontomedia:aero_island",
        "ontomedia:primary_theme": "ontomedia:transformation",
        "ontomedia:writing_style": "ontomedia:style"
      },
      "ontomedia:chapter_planning": {
        "@id": "ontomedia:chapter_planning",
        "@type": "ontomedia:ChapterPlanning",
        "ontomedia:act_1": {
          "@id": "ontomedia:act_1",
          "@type": "ontomedia:Act",
          "ontomedia:name": "The Escape",
          "ontomedia:description": "Katrine's journey from Copenhagen to Ærø, establishing the foundation for her transformation",
          "ontomedia:chapters": [
            {
              "@id": "ontomedia:chapter_1",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 1,
              "ontomedia:name": "Ægteskab",
              "ontomedia:description": "Katrine faces an unwanted proposal that forces her to confront her dissatisfaction with urban life",
              "ontomedia:plot_progression": {
                "ontomedia:main_plot": "ontomedia:urban_burnout",
                "ontomedia:sub_plots": [
                  "ontomedia:professional_independence",
                  "ontomedia:romantic_freedom"
                ]
              },
              "ontomedia:emotional_arc": "exhaustion_to_hope",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_initial",
                "ontomedia:supporting": [
                  "ontomedia:mads_initial",
                  "ontomedia:lily_initial"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:aeroskobing",
                "ontomedia:contrast": "ontomedia:island_medical_practice"
              },
              "ontomedia:weather": "ontomedia:aero_weather_spring",
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_1_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_1_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Hospital Corridor",
                    "ontomedia:description": "Katrine walks through the sterile hospital corridor, her white coat a stark contrast to the grey walls. The weight of her medical bag feels heavier than usual, mirroring the burden of her career choices. The sound of her heels echoes like a metronome counting down to a decision she doesn't want to make.",
                    "ontomedia:key_plot_point": "Introduction to Katrine's professional dissatisfaction",
                    "ontomedia:narrative_devices": {
                      "setting": "Copenhagen Hospital corridor",
                      "weather": "Grey, overcast",
                      "time_of_day": "Early morning",
                      "symbolic_elements": ["White coat", "Grey walls", "Medical bag", "Echoing footsteps"],
                      "sensory_details": ["Sterile air", "Footsteps echoing", "Distant medical equipment", "Coffee from break room"],
                      "emotional_tone": "Exhaustion, dissatisfaction, resignation"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_1_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Unwanted Proposal",
                    "ontomedia:description": "In the hospital's administrative office, Dr. Marcus Nielsen presents Katrine with a prestigious position and a personal proposal. The polished mahogany desk between them feels like a barrier, while the city view outside the window offers a glimpse of the life she's expected to embrace.",
                    "ontomedia:key_plot_point": "Catalyst for change",
                    "ontomedia:narrative_devices": {
                      "setting": "Hospital administrative office",
                      "weather": "Bright but cold",
                      "time_of_day": "Mid-morning",
                      "symbolic_elements": ["Mahogany desk", "City view", "Official documents", "Engagement ring box"],
                      "sensory_details": ["Polished wood scent", "City sounds", "Paper rustling", "Tense silence"],
                      "emotional_tone": "Pressure, discomfort, trapped"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_1_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Letter",
                    "ontomedia:description": "Alone in her apartment, Katrine reads her grandmother's old letter about the island clinic. The yellowed paper and familiar handwriting bring memories of summer visits to Ærø, while the city lights outside her window seem to dim in comparison to the island's remembered glow.",
                    "ontomedia:key_plot_point": "First step toward change",
                    "ontomedia:narrative_devices": {
                      "setting": "Katrine's apartment",
                      "weather": "Evening rain",
                      "time_of_day": "Night",
                      "symbolic_elements": ["Yellowed letter", "City lights", "Family photos", "Medical certificates"],
                      "sensory_details": ["Rain on windows", "Paper scent", "Distant traffic", "Tea cooling"],
                      "emotional_tone": "Nostalgia, hope, determination"
                    }
                  }
                ]
              }
            },
            {
              "@id": "ontomedia:chapter_2",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 2,
              "ontomedia:name": "Opdagelse",
              "ontomedia:description": "Katrine finds her grandmother's journal in the coastal farmhouse, revealing a medical mystery",
              "ontomedia:emotional_arc": "wonder_to_uncertainty",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:grandmother_house",
                "ontomedia:contrast": "ontomedia:coastal_garden"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_2_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_2_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Arrival",
                    "ontomedia:description": "Katrine arrives at her grandmother's coastal farmhouse, the salty breeze carrying memories of childhood summers. The old wooden door creaks open to reveal a house frozen in time, with her grandmother's medical bag still sitting by the entrance as if waiting for her return.",
                    "ontomedia:key_plot_point": "Connection to grandmother's legacy",
                    "ontomedia:narrative_devices": {
                      "setting": "Coastal farmhouse entrance",
                      "weather": "Baltic breeze",
                      "time_of_day": "Late afternoon",
                      "symbolic_elements": ["Creaking door", "Medical bag", "Family photos", "Coastal view"],
                      "sensory_details": ["Salt air", "Wooden floor creaks", "Seagull calls", "Distant waves"],
                      "emotional_tone": "Nostalgia, connection, anticipation"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_2_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Journal",
                    "ontomedia:description": "In the old study, Katrine discovers her grandmother's medical journal. The pages are filled with detailed observations about island illnesses and traditional remedies, along with sketches of local herbs. A particular entry about a mysterious seasonal condition catches her attention.",
                    "ontomedia:key_plot_point": "Discovery of medical mystery",
                    "ontomedia:narrative_devices": {
                      "setting": "Study room",
                      "weather": "Sunset",
                      "time_of_day": "Evening",
                      "symbolic_elements": ["Old journal", "Herb sketches", "Medical notes", "Setting sun"],
                      "sensory_details": ["Old paper scent", "Dust motes", "Pen scratching", "Distant sea"],
                      "emotional_tone": "Wonder, curiosity, connection"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_2_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Garden",
                    "ontomedia:description": "Following her grandmother's notes, Katrine explores the coastal garden. The medicinal herbs are still thriving, their scents mingling with the sea air. As she identifies plants mentioned in the journal, she begins to understand the depth of her grandmother's knowledge and the mystery she's uncovered.",
                    "ontomedia:key_plot_point": "First step into island medicine",
                    "ontomedia:narrative_devices": {
                      "setting": "Coastal garden",
                      "weather": "Baltic evening",
                      "time_of_day": "Dusk",
                      "symbolic_elements": ["Medicinal herbs", "Garden paths", "Coastal view", "Old tools"],
                      "sensory_details": ["Herb scents", "Sea breeze", "Crunching gravel", "Bird calls"],
                      "emotional_tone": "Discovery, uncertainty, purpose"
                    }
                  }
                ]
              }
            },
            {
              "@id": "ontomedia:chapter_3",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 3,
              "ontomedia:name": "Ankomst",
              "ontomedia:description": "Katrine's first day at the clinic reveals both the challenges and possibilities of island life",
              "ontomedia:emotional_arc": "uncertainty_to_determination",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:island_medical_practice",
                "ontomedia:contrast": "ontomedia:aeroskobing"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_3_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_3_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Meeting",
                    "ontomedia:description": "Katrine arrives at the ferry dock, her medical bag slipping from her shoulder. Mads catches it, their hands meeting over her grandmother's stethoscope. 'Dette tilhørte Dr. Marie Nielsen,' he says, recognizing the family heirloom. 'Hun var min første mentor.' The moment becomes a bridge between past and present.",
                    "ontomedia:key_plot_point": "First connection to island and potential romance",
                    "ontomedia:narrative_devices": {
                      "setting": "Ferry dock",
                      "weather": "Morning sea mists clearing",
                      "time_of_day": "Early morning arrival",
                      "symbolic_elements": ["Grandmother's stethoscope", "Medical bag", "Ferry deck", "Morning mist"],
                      "sensory_details": ["Sea air", "Dock sounds", "Bag strap slipping", "Salt spray on lips"],
                      "emotional_tone": "Hopeful uncertainty, first connection",
                      "cultural_elements": {
                        "language": ["Dette tilhørte", "Hun var min første mentor"],
                        "traditions": ["Morning ferry arrival", "Island greeting customs"]
                      }
                    }
                  },
                  {
                    "@id": "ontomedia:scene_3_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Clinic Tour",
                    "ontomedia:description": "Mads shows Katrine around the clinic, a blend of modern equipment and traditional healing spaces. The contrast between the sterile treatment rooms and the warm, herb-scented consultation area reflects the island's approach to medicine.",
                    "ontomedia:key_plot_point": "Introduction to island medical practice",
                    "ontomedia:narrative_devices": {
                      "setting": "Island clinic",
                      "weather": "Bright morning",
                      "time_of_day": "Mid-morning",
                      "symbolic_elements": ["Modern equipment", "Herb garden view", "Treatment rooms", "Traditional remedies"],
                      "sensory_details": ["Antiseptic", "Herb scents", "Footsteps on wooden floors", "Distant sea"],
                      "emotional_tone": "Professional curiosity, cultural learning"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_3_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Patient",
                    "ontomedia:description": "A local fisherman arrives with a minor injury, watching Katrine with cautious interest. As she treats him, combining modern medicine with traditional remedies, she feels the weight of both her grandmother's legacy and the community's expectations.",
                    "ontomedia:key_plot_point": "First test of medical adaptation",
                    "ontomedia:narrative_devices": {
                      "setting": "Clinic treatment room",
                      "weather": "Clear morning",
                      "time_of_day": "Late morning",
                      "symbolic_elements": ["Medical bag", "Traditional remedies", "Patient's weathered hands", "Herb garden"],
                      "sensory_details": ["Salt and fish scent", "Herb tea brewing", "Bandage rustling", "Soft Danish voices"],
                      "emotional_tone": "Professional focus, cultural bridge"
                    }
                  }
                ]
              }
            },
            {
              "@id": "ontomedia:chapter_4",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 4,
              "ontomedia:name": "Morgen",
              "ontomedia:description": "Katrine's first morning in Ærøskøbing, exploring the town and feeling the weight of her decision",
              "ontomedia:emotional_arc": "determination_to_purpose",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:town_square",
                "ontomedia:contrast": "ontomedia:clinic"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_4_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_4_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Morning Market",
                    "ontomedia:description": "Katrine explores the town square's morning market, where vendors recognize her as Marie's granddaughter. The fresh produce, local crafts, and warm greetings create a stark contrast to Copenhagen's impersonal pace.",
                    "ontomedia:key_plot_point": "First real connection to island life",
                    "ontomedia:narrative_devices": {
                      "setting": "Town square market",
                      "weather": "Clear spring morning",
                      "time_of_day": "Early morning",
                      "symbolic_elements": ["Market stalls", "Fresh produce", "Local crafts", "Town square"],
                      "sensory_details": ["Fresh bread", "Market chatter", "Sea breeze", "Warm pastry"],
                      "emotional_tone": "Discovery, belonging, contrast"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_4_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Café Meeting",
                    "ontomedia:description": "At Anna's café, Katrine meets Lily, a young apprentice healer. Over coffee and traditional pastries, they discuss her grandmother's methods and the island's medical traditions.",
                    "ontomedia:key_plot_point": "Connection to next generation",
                    "ontomedia:narrative_devices": {
                      "setting": "Anna's café",
                      "weather": "Bright morning",
                      "time_of_day": "Mid-morning",
                      "symbolic_elements": ["Coffee cups", "Traditional pastries", "Herb garden view", "Old photos"],
                      "sensory_details": ["Coffee aroma", "Pastry sweetness", "Warm conversation", "Sea breeze"],
                      "emotional_tone": "Mentorship, tradition, hope"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_4_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Harbor Walk",
                    "ontomedia:description": "Walking along the harbor, Katrine reflects on her decision to stay. The fishing boats, historic buildings, and gentle sea breeze help her understand the island's rhythm and her place within it.",
                    "ontomedia:key_plot_point": "Acceptance of new life",
                    "ontomedia:narrative_devices": {
                      "setting": "Harbor walk",
                      "weather": "Baltic breeze",
                      "time_of_day": "Late morning",
                      "symbolic_elements": ["Fishing boats", "Historic buildings", "Harbor view", "Seagulls"],
                      "sensory_details": ["Salt air", "Wooden docks", "Seagull calls", "Gentle waves"],
                      "emotional_tone": "Reflection, peace, purpose"
                    }
                  }
                ]
              }
            },
            {
              "@id": "ontomedia:chapter_5",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 5,
              "ontomedia:name": "System",
              "ontomedia:description": "Katrine learns about the island's medical system and the network of traditional healers",
              "ontomedia:emotional_arc": "purpose_to_anxiety",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:clinic",
                "ontomedia:contrast": "ontomedia:herb_garden"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_5_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_5_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Network Meeting",
                    "ontomedia:description": "In the clinic's herb-scented consultation room, Katrine meets with the island's network of traditional healers. Each brings their own expertise, from midwifery to herbal medicine, creating a tapestry of knowledge that spans generations.",
                    "ontomedia:key_plot_point": "Understanding island medical network",
                    "ontomedia:narrative_devices": {
                      "setting": "Clinic consultation room",
                      "weather": "Spring showers",
                      "time_of_day": "Morning meeting",
                      "symbolic_elements": ["Herb bundles", "Old medical texts", "Family remedies", "Community map"],
                      "sensory_details": ["Herb tea brewing", "Rain on windows", "Soft Danish voices", "Paper rustling"],
                      "emotional_tone": "Professional respect, cultural learning"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_5_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Garden Tour",
                    "ontomedia:description": "Lily leads Katrine through the clinic's herb garden, explaining the medicinal properties of each plant. The garden becomes a living classroom, connecting modern medicine with traditional knowledge.",
                    "ontomedia:key_plot_point": "Learning traditional medicine",
                    "ontomedia:narrative_devices": {
                      "setting": "Clinic herb garden",
                      "weather": "Clearing showers",
                      "time_of_day": "Late morning",
                      "symbolic_elements": ["Medicinal herbs", "Garden paths", "Old tools", "Rainbow after rain"],
                      "sensory_details": ["Wet earth", "Herb scents", "Bird songs", "Dripping leaves"],
                      "emotional_tone": "Discovery, mentorship, connection"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_5_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Protocol Discussion",
                    "ontomedia:description": "Back in the clinic, Katrine and Mads discuss how to integrate traditional methods with modern medical protocols. The tension between old and new becomes a creative challenge rather than a conflict.",
                    "ontomedia:key_plot_point": "Bridging medical approaches",
                    "ontomedia:narrative_devices": {
                      "setting": "Clinic office",
                      "weather": "Bright afternoon",
                      "time_of_day": "Afternoon",
                      "symbolic_elements": ["Medical charts", "Herb samples", "Protocol books", "Family photos"],
                      "sensory_details": ["Coffee brewing", "Paper shuffling", "Soft conversation", "Distant sea"],
                      "emotional_tone": "Professional collaboration, mutual respect"
                    }
                  }
                ]
              }
            },
            {
              "@id": "ontomedia:chapter_6",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 6,
              "ontomedia:name": "Skridt",
              "ontomedia:description": "Katrine's first small victories in island medicine",
              "ontomedia:emotional_arc": "anxiety_to_conflict",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:fisherman_cottage",
                "ontomedia:contrast": "ontomedia:clinic"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_6_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_6_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Home Visit",
                    "ontomedia:description": "Katrine makes her first home visit to a fisherman's cottage, where she treats a child's fever using both modern medicine and traditional remedies. The family's trust in her grandmother's methods helps bridge the gap between old and new.",
                    "ontomedia:key_plot_point": "First medical success",
                    "ontomedia:narrative_devices": {
                      "setting": "Fisherman's cottage",
                      "weather": "Coastal mist",
                      "time_of_day": "Early morning",
                      "symbolic_elements": ["Family photos", "Herb bundles", "Medical bag", "Coastal view"],
                      "sensory_details": ["Wood smoke", "Herb tea", "Child's soft breathing", "Distant waves"],
                      "emotional_tone": "Professional care, cultural acceptance"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_6_2",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Market Feedback",
                    "ontomedia:description": "At the town market, Katrine receives positive feedback about her treatment methods. The community's acceptance of her approach validates her decision to stay.",
                    "ontomedia:key_plot_point": "Community acceptance",
                    "ontomedia:narrative_devices": {
                      "setting": "Town market",
                      "weather": "Bright morning",
                      "time_of_day": "Market hours",
                      "symbolic_elements": ["Market stalls", "Fresh produce", "Local crafts", "Town square"],
                      "sensory_details": ["Market chatter", "Fresh bread", "Sea breeze", "Warm greetings"],
                      "emotional_tone": "Belonging, validation, hope"
                    }
                  },
                  {
                    "@id": "ontomedia:scene_6_3",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The First Challenge",
                    "ontomedia:description": "A skeptical patient questions Katrine's methods, creating tension between traditional and modern approaches. The conflict forces her to defend her integrated approach.",
                    "ontomedia:key_plot_point": "First professional conflict",
                    "ontomedia:narrative_devices": {
                      "setting": "Clinic consultation room",
                      "weather": "Gathering clouds",
                      "time_of_day": "Late afternoon",
                      "symbolic_elements": ["Medical certificates", "Herb garden", "Family photos", "Storm clouds"],
                      "sensory_details": ["Tense silence", "Distant thunder", "Paper rustling", "Herb scents"],
                      "emotional_tone": "Professional tension, cultural conflict"
                    }
                  }
                ]
              }
            },
            {
              "@id": "ontomedia:chapter_7",
              "@type": "ontomedia:Chapter",
              "ontomedia:number": 7,
              "ontomedia:name": "Velkomst",
              "ontomedia:description": "A small gathering introduces Katrine to the community",
              "ontomedia:emotional_arc": "conflict_to_doubt",
              "ontomedia:character_development": {
                "ontomedia:protagonist": "ontomedia:katrine_changing",
                "ontomedia:supporting": [
                  "ontomedia:mads_changing",
                  "ontomedia:lily_growing"
                ]
              },
              "ontomedia:location_progression": {
                "ontomedia:primary": "ontomedia:anna_cafe",
                "ontomedia:contrast": "ontomedia:town_square"
              },
              "ontomedia:scene_scaffold": {
                "@id": "ontomedia:chapter_7_scenes",
                "@type": "ontomedia:SceneScaffold",
                "ontomedia:scenes": [
                  {
                    "@id": "ontomedia:scene_7_1",
                    "@type": "ontomedia:SceneSketch",
                    "ontomedia:name": "The Emergency Call",
                    "ontomedia:description": "A late-night emergency call brings Katrine to a remote farmhouse where a child has fallen ill. The stormy weather and remote location test her medical skills and determination.",
                    "ontomedia:key_plot_point": "First emergency response",
                    "ontomedia:narrative_devices": {
                      "setting": "Remote farmhouse",
                      "weather": "Stormy night",
                      "time_of_day": "Late night",
                      "symbolic_elements": ["Storm clouds", "Medical bag", "Oil lamps", "Family heirlooms"],
                      "sensory_details": ["Thunder", "Rain on windows", "Child's labored breathing", "Wood smoke"],
                      "emotional_tone": "Urgency, determination, isolation"
                    }
                  },
                  {
